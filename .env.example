# Secret values: replace locally and never commit the populated file.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GITHUB_PRIVATE_KEY=replace-with-the-complete-github-app-private-key-pem
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Non-secret GitHub App identifier.
GITHUB_APP_ID=123456

# Self-hosted AWS resources created by the reference Terraform stack.
DYNAMODB_PIPELINE_TABLE=llamapreview-pipeline-runs
CONTEXT_S3_BUCKET=replace-with-your-private-artifact-bucket
RUN_ARTIFACT_BUCKET=replace-with-your-private-artifact-bucket
PUBLICATION_ARTIFACT_BUCKET=replace-with-your-private-artifact-bucket
DEEPSEEK_TRACE_S3_BUCKET=replace-with-your-private-artifact-bucket
RUN_ARTIFACT_PREFIX=pipeline

# Safe initial behavior. Terraform sets the complete tested runtime profile.
DRY_RUN=true
DEEPSEEK_TRACE_MODE=summary
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TRANSPORT_MODEL_OVERRIDE=deepseek-v4-flash
